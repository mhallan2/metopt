    \PYG{k}{def} \PYG{n+nf}{update\PYGZus{}lipschitz}\PYG{p}{(}\PYG{n}{x\PYGZus{}points}\PYG{p}{,} \PYG{n}{y\PYGZus{}points}\PYG{p}{,} \PYG{n}{current\PYGZus{}M}\PYG{o}{=\PYGZhy{}}\PYG{n}{np}\PYG{o}{.}\PYG{n}{inf}\PYG{p}{,} \PYG{n}{safety}\PYG{o}{=}\PYG{l+m+mf}{1.09}\PYG{p}{,):}
        \PYG{n}{order} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{argsort}\PYG{p}{(}\PYG{n}{x\PYGZus{}points}\PYG{p}{)}
        \PYG{n}{x\PYGZus{}sorted} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{array}\PYG{p}{(}\PYG{n}{x\PYGZus{}points}\PYG{p}{)[}\PYG{n}{order}\PYG{p}{]}
        \PYG{n}{y\PYGZus{}sorted} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{array}\PYG{p}{(}\PYG{n}{y\PYGZus{}points}\PYG{p}{)[}\PYG{n}{order}\PYG{p}{]}

        \PYG{n}{slopes} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{abs}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{diff}\PYG{p}{(}\PYG{n}{y\PYGZus{}sorted}\PYG{p}{)} \PYG{o}{/} \PYG{n}{np}\PYG{o}{.}\PYG{n}{diff}\PYG{p}{(}\PYG{n}{x\PYGZus{}sorted}\PYG{p}{))}
        \PYG{n}{new\PYGZus{}estimate} \PYG{o}{=} \PYG{n}{safety} \PYG{o}{*} \PYG{n}{np}\PYG{o}{.}\PYG{n}{max}\PYG{p}{(}\PYG{n}{slopes}\PYG{p}{)}

        \PYG{k}{return} \PYG{n+nb}{max}\PYG{p}{(}\PYG{n}{current\PYGZus{}M}\PYG{p}{,} \PYG{n}{new\PYGZus{}estimate}\PYG{p}{)}
