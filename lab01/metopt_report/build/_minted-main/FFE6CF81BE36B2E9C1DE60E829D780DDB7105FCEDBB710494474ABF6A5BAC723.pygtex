                \PYG{n}{x1} \PYG{o}{=} \PYG{n}{left} \PYG{o}{+} \PYG{p}{(}\PYG{n}{right} \PYG{o}{\PYGZhy{}} \PYG{n}{left}\PYG{p}{)} \PYG{o}{*} \PYG{n}{fib}\PYG{p}{(}\PYG{n}{n} \PYG{o}{\PYGZhy{}} \PYG{l+m+mi}{2}\PYG{p}{)} \PYG{o}{/} \PYG{n}{fib}\PYG{p}{(}\PYG{n}{n}\PYG{p}{)}
